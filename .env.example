# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# Leave empty for local SQLite. Production: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Leave empty for in-memory cache locally. Production: redis://host:6379/0
REDIS_URL=
# With REDIS_URL set, emails and scheduled jobs run on a Celery worker (see README). Without it they run inline.

# Email. Leave EMAIL_HOST empty to print emails in the terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Eunice Wears <hello@eunicewears.example>
# Brevo API key (xkeysib-...). Sends email over HTTPS; use this on Render, whose free plan blocks SMTP.
BREVO_API_KEY=

# Django's built-in admin (kept as a back office fallback). Change the path in production.
DJANGO_ADMIN_PATH=backoffice/

# Paystack. Use sk_test_... keys while developing. With both empty and DEBUG=True the
# local sandbox gateway is used so the full checkout can be exercised offline.
# Webhook URL to set on the Paystack dashboard: https://<your-domain>/api/payments/webhook/
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Product photos. Empty = saved to the local media/ folder. Production: cloudinary://<key>:<secret>@<cloud-name>
CLOUDINARY_URL=

# Production only: the owner account created on first deploy (password at least 10 characters).
OWNER_EMAIL=
OWNER_PASSWORD=
